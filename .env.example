# PetMatch environment configuration
# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored and must never be committed.

# ---------------------------------------------------------------
# Cloud database - Somee.com (MS SQL Server 2014 Express)
# ---------------------------------------------------------------
DB_SERVER=your-instance.mssql.somee.com
DB_NAME=your-database-name
DB_USER=your-somee-login
DB_PASSWORD=
# SQLAlchemy URL is assembled from the parts above by app/config.py.
# Override it directly here only if you need a non-standard connection.
# DATABASE_URL=mssql+pymssql://user:pass@host/dbname

# Local development database (Docker Postgres or SQLite) - optional.
# When set, this overrides the cloud database for local runs.
# LOCAL_DATABASE_URL=sqlite:///petmatch_dev.db

# ---------------------------------------------------------------
# LLM - Ollama (local, no API key required)
# ---------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_CHAT_MODEL writes match explanations inside the tool-using loop.
# OLLAMA_CHAT_MODEL_FAST interprets natural-language searches: a short prompt,
# no tools, so a smaller model is fine. Point the first at qwen2.5:7b-instruct
# once it finishes pulling (blocked at 95% by the corporate proxy so far) and
# keep the second on the 3B.
OLLAMA_CHAT_MODEL=qwen2.5:3b-instruct
OLLAMA_CHAT_MODEL_FAST=qwen2.5:3b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text

# ---------------------------------------------------------------
# Web search - Tavily
# Get a free key (1000 searches/month) at https://tavily.com
# ---------------------------------------------------------------
TAVILY_API_KEY=
# When the key is absent the agent falls back to the stub provider,
# so the test suite still runs offline.

# ---------------------------------------------------------------
# Vector database
# ---------------------------------------------------------------
CHROMA_PERSIST_DIR=data/chroma
RAG_COLLECTION_NAME=petmatch_knowledge

# ---------------------------------------------------------------
# Flask
# ---------------------------------------------------------------
FLASK_SECRET_KEY=change-me-to-a-long-random-string
FLASK_ENV=development
FLASK_PORT=5000

# ---------------------------------------------------------------
# Agent process
# ---------------------------------------------------------------
AGENT_POLL_INTERVAL_SECONDS=3
AGENT_MAX_REASONING_STEPS=8
INVITATION_EXPIRY_HOURS=72
